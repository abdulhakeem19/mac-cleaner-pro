# Mac Cleaner Pro - Environment Variables Template
# Copy this to .env.local for local development

# ============================================================================
# RAZORPAY - Payment Gateway (India)
# ============================================================================
# Get from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=xxxxx

# Webhook secret from: https://dashboard.razorpay.com/app/webhooks
RAZORPAY_WEBHOOK_SECRET=xxxxx

# Public key for client-side Razorpay SDK
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxx

# ============================================================================
# SUPABASE - Database
# ============================================================================
# Get from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_KEY=xxxxx  # Service role key (server-side only, bypass RLS)

# ============================================================================
# LICENSE KEYS - Ed25519 Signing
# ============================================================================
# Generate with: node scripts/generate-keypair.js
# IMPORTANT: Private key must NEVER be committed to git!

LICENSE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
MC4CAQAwBQYDK2VwBCIEIxxxxx
-----END PRIVATE KEY-----"

LICENSE_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
MCowBQYDK2VwAyEAxxxxx
-----END PUBLIC KEY-----"

# ============================================================================
# RESEND - Transactional Email
# ============================================================================
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================================
# PADDLE (Optional - for international payments, future)
# ============================================================================
NEXT_PUBLIC_PADDLE_PRO_PRODUCT=
NEXT_PUBLIC_PADDLE_FAMILY_PRODUCT=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=

# ============================================================================
# DEVELOPMENT
# ============================================================================
NODE_ENV=development
