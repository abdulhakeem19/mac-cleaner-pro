# ── Paddle (international / USD) ──────────────────────────────────────────
# Get from paddle.com → Developer Tools → Authentication + Products
NEXT_PUBLIC_PADDLE_VENDOR_ID=
NEXT_PUBLIC_PADDLE_PRO_PRODUCT=
NEXT_PUBLIC_PADDLE_FAMILY_PRODUCT=

# ── Razorpay (India / INR) ─────────────────────────────────────────────────
# Get from dashboard.razorpay.com → Settings → API Keys
# NEXT_PUBLIC_ key is safe for browser. SECRET stays server-side only (Netlify env).
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
